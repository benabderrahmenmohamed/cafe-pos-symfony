# Which backend the app talks to: rest (default) is the café, the Symfony server in api/; memory is a
# backend that lives in the browser tab, for the credential-free demo.
VITE_BACKEND=rest

# Where the Symfony server is, without the /api/v1 prefix. `php -S 127.0.0.1:8000 -t public` in api/
# serves it here; `docker compose --profile cafe up` serves it on http://localhost:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000
